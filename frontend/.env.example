# URL pública del API (navegador). Vacío = mismo origen (/api), con API_PROXY_URL configurado.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# URL del API para los Server Components (opcional; por defecto NEXT_PUBLIC_API_URL)
API_URL_INTERNA="http://localhost:4000"
# URL pública del sitio (metadata, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Opcional: proxy /api/* → backend (URL provisionales en dominios distintos)
API_PROXY_URL=""
