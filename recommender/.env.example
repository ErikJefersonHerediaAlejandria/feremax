# Base de datos (la misma que el backend). Se aceptan las URL de Prisma: ?schema= y ?pgbouncer= se ignoran.
DATABASE_URL="postgresql://ferremax@localhost:5433/ferremax_dev"
# Clave compartida con el backend (cabecera X-Internal-Key)
RECOMMENDER_KEY="cambiar-esto"
PORT=8001
# Supabase Storage (opcional): bucket privado donde se guardan los modelos entrenados
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
BUCKET_MODELOS="modelos"
DIR_ARTEFACTOS="artefactos"
SEMILLA=42
