# Conexión usada por la app (en Supabase: pooler, puerto 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://ferremax@localhost:5433/ferremax_dev?schema=public"
# Conexión directa usada por prisma migrate (en Supabase: puerto 5432)
DIRECT_URL="postgresql://ferremax@localhost:5433/ferremax_dev?schema=public"
# Contraseña inicial del admin creado por el seed (cámbiala en producción)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-esto"
JWT_SECRET="cambiar-esto-por-un-secreto-largo"
RECOMMENDER_URL="http://localhost:8001"
RECOMMENDER_KEY="cambiar-esto"
# Orígenes permitidos por CORS (separados por coma)
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000
# production desactiva Swagger (/api/docs) y exige JWT_SECRET de 32+ caracteres
NODE_ENV="development"
# La cookie del admin es Secure; ponlo en false solo si pruebas por http desde otra máquina
COOKIE_SECURE="true"
# Límites por minuto y por IP (rutas públicas de escritura y login)
THROTTLE_EVENTOS=600
THROTTLE_CONFIRMAR=20
THROTTLE_LOGIN=5
