# Copia este archivo como .env.supabase (ignorado por git) y completa los valores de tu proyecto Supabase.
# Transaction pooler (6543) — lo usa la app
DATABASE_URL="postgresql://postgres.<ref>:<CONTRASEÑA>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432) — lo usan las migraciones y el seed
DIRECT_URL="postgresql://postgres.<ref>:<CONTRASEÑA>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="<contraseña-fuerte>"
